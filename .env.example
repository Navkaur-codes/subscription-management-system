# Neon → Project → Connect. Pooled string (host contains "-pooler") for the app:
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Direct (non-pooled) string, used by prisma migrate:
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Any long random string (signs session cookies)
AUTH_SECRET="change-me-to-a-long-random-string"
APP_URL="http://localhost:3000"

# Optional real SMTP. Leave empty to use a free Ethereal test inbox (preview links printed in console/UI).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Brightloop Billing <billing@brightloop.test>"
